# ───────────────────────── Telegram ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEBAPP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ───────────────────────── Tribute (payments) ───────────────
TRIBUTE_API_KEY=
TRIBUTE_PRODUCT_LINK=https://tribute.tg/p/your-product
TRIBUTE_PRODUCT_ID_FULL_REPORT=
TRIBUTE_WEBHOOK_SECRET_OR_API_KEY=

# ───────────────────────── Astro API ────────────────────────
ASTRO_API_CLIENT_ID=
ASTRO_API_CLIENT_SECRET=
ASTRO_API_BASE_URL=
# If empty / missing keys, the AstroApiAdapter falls back to deterministic mock data.

# ───────────────────────── AI (LLM) ─────────────────────────
# Default provider is Anthropic (Claude). Leave the key empty to use the mock generator.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Optional OpenAI fallback (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ───────────────────────── Supabase / DB ────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PDF_STORAGE_BUCKET=reports
# If Supabase keys are empty, the app uses an in-memory store (dev only).

# ───────────────────────── Pricing / offer ──────────────────
FULL_REPORT_PRICE=990
FULL_REPORT_CURRENCY=RUB

# ───────────────────────── Server ───────────────────────────
PORT=4000
NODE_ENV=development
