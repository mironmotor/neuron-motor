# ───────────────────────── Telegram ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEBAPP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ───────────────────────── Tribute (payments) ───────────────
TRIBUTE_API_KEY=
TRIBUTE_PRODUCT_LINK=https://tribute.tg/p/your-product
TRIBUTE_PRODUCT_ID_FULL_REPORT=
TRIBUTE_WEBHOOK_SECRET_OR_API_KEY=

# ───────────────────────── Astro API ────────────────────────
ASTRO_API_CLIENT_ID=
ASTRO_API_CLIENT_SECRET=
ASTRO_API_BASE_URL=
# If empty / missing keys, the AstroApiAdapter falls back to deterministic mock data.

# ───────────────────────── AI (LLM) ─────────────────────────
# You need EXACTLY ONE LLM provider. Leave keys empty to use the mock generator.
#
#   LLM_PROVIDER=anthropic   -> Claude (default), needs ANTHROPIC_API_KEY
#   LLM_PROVIDER=openai      -> any OpenAI-COMPATIBLE provider, needs OPENAI_API_KEY
#                               (OpenAI, Qwen, MiniMax, DeepSeek, Gemini-compat, local…)
LLM_PROVIDER=anthropic

# — Claude —
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# — OpenAI-compatible — set OPENAI_BASE_URL to your provider's endpoint:
#   OpenAI    : https://api.openai.com/v1            (model: gpt-4o)
#   Qwen      : https://dashscope-intl.aliyuncs.com/compatible-mode/v1  (model: qwen-plus)
#   MiniMax   : https://api.minimax.io/v1            (model: MiniMax-Text-01)
#   DeepSeek  : https://api.deepseek.com/v1          (model: deepseek-chat)
#   Gemini    : https://generativelanguage.googleapis.com/v1beta/openai (model: gemini-2.0-flash)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ───────────────────────── Supabase / DB ────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PDF_STORAGE_BUCKET=reports
# If Supabase keys are empty, the app uses an in-memory store (dev only).

# ───────────────────────── Pricing / offer ──────────────────
FULL_REPORT_PRICE=990
FULL_REPORT_CURRENCY=RUB

# ───────────────────────── Server ───────────────────────────
PORT=4000
NODE_ENV=development
